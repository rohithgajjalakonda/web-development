            width: 230px;
            margin: 15px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
            transition: 0.5s;
        }

        .card:hover {
            transform: scale(1.05);
        }

        .card img {
            width: 100%;
            height: 280px;
            border-radius: 8px;
        }

        .rating {
            color: orange;
            font-weight: bold;
        }

        section {
            padding: 20px;
        }

        footer {
            background-color: black;
            color: white;
            padding: 15px;
        }

        @media(max-width: 600px) {
            nav a {
                display: block;
                margin: 10px;
            }

            .card {
                width: 85%;
            }
        }
    </style>
</head>

